# =============================================================================
# AdiYogi web client — environment template (Vite)
#
# Copy to `client/.env` for local development:
#   cp client/.env.example client/.env
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. Anything prefixed with VITE_ is PUBLIC. Never put an API key,
# token, password or other secret in this file — the AI provider key and the
# JWT/session secrets live only in the server environment (see
# server/.env.example) and are never part of the browser build.
#
# Precedence: real environment variables (Docker --build-arg / Vercel project
# env / shell export) override these files. The Docker image sets
# VITE_API_BASE_URL through a build arg; the Vercel project sets it through the
# dashboard. This file is for local `npm run dev` / `npm run build`.
# =============================================================================

# Base URL of the API, WITHOUT a trailing slash. client/src/api/client.js uses it
# for every request (and appends /api/v1 paths itself only if you include them).
#   Vite dev (default):   leave unset -> "/api/v1", proxied to the local API by
#                         client/vite.config.js (same-origin, cookies just work)
#   docker compose:        leave unset -> "/api/v1", proxied by client/nginx.conf
#   external API:          https://api.example.com/api/v1
#   Vercel:                https://<your-api>.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Optional UI title. Safe, public value; defaults to "AdiYogi" when unset.
VITE_APP_NAME=AdiYogi

# Dev-server only: where client/vite.config.js proxies /api and /health. This is
# read by the Vite config at dev-server start (process.env, not import.meta), so
# it is NOT bundled and is NOT a public runtime variable.
#   docker compose / host API: http://localhost:4000
VITE_PROXY_TARGET=http://localhost:4000

# There is deliberately NO analytics toggle: the default build loads no
# third-party scripts (see docs/SECURITY.md). Adding one would require a CSP
# connect-src/script-src change and a privacy review first.

# Production: `client/.env.production` sets the deployed API base so a Vercel build works
# without dashboard configuration. Anything VITE_* is compiled into the public bundle.
# VITE_API_BASE_URL=https://your-api.example.com/api/v1

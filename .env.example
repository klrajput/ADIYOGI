# =============================================================================
# AdiYogi — environment template
# Copy to `.env` at the repository root (server reads it), fill in real values.
# NEVER commit `.env`. Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
LOG_LEVEL=info

# --- database ----------------------------------------------------------------
# Local dev: mongodb://127.0.0.1:27017/adiyogi
# Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adiyogi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/adiyogi
MONGODB_DB_NAME=adiyogi

# --- client / CORS -----------------------------------------------------------
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (e.g. https://adiyogi.vercel.app)
CLIENT_URLS=

# --- auth / crypto -----------------------------------------------------------
# Required. 32+ random hex chars each. Server refuses to boot in production without them.
JWT_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_TTL_MIN=15
SESSION_TTL_DAYS=30
# Set COOKIE_DOMAIN only when the API is on a subdomain of the web app.
COOKIE_DOMAIN=
# Force `Secure` cookies. Automatically true when NODE_ENV=production.
COOKIE_SECURE=false

# --- AI provider (server-side only — NEVER expose to the client) -------------
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
# When true, a provider failure additionally returns an explicitly-labelled
# NON-AI guided exercise (never a fabricated AI reply).
AI_FALLBACK_GUIDED=true

# --- privacy / retention -----------------------------------------------------
CHAT_RETENTION_DAYS=30
CRISIS_EVENT_RETENTION_DAYS=90

# --- rate limits (defaults are sane; override only if needed) ---------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
CHAT_RATE_LIMIT_MAX=20

# --- bootstrap ---------------------------------------------------------------
SEED_ON_START=true
# Optional: create an initial admin account on start (only if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# AdiYogi API — environment template (server scope)
#
# The API loads environment variables in this order:
#   1. the process environment (Docker/Render/compose) — wins;
#   2. `<repo root>/.env`   (server/src/config/env.js checks this first);
#   3. `server/.env`        (only if the root .env does not exist);
#   4. built-in defaults below (development-safe values).
#
# For local development the repository-root `.env` (copied from
# `.env.example`) is the canonical file, because it is what `npm run dev` and
# `docker compose up` read. Use this file when you want a server-scoped env file
# (e.g. when the API runs without the repository root, or with a different .env).
#
# NEVER commit a real `.env`. Generate the two secrets with:
#   openssl rand -hex 32
#
# The API fails fast at boot if JWT_SECRET / SESSION_SECRET are missing or
# shorter than 16 characters, or if MONGODB_URI is empty. In production
# (NODE_ENV=production) it also refuses to boot when CLIENT_URL points at
# localhost. That failure is intentional: a misconfigured deployment must not
# start silently.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
# Render/Railway inject PORT; Docker/compose maps 4000.
PORT=4000
API_BASE_PATH=/api/v1
# winston level: error | warn | info | debug
LOG_LEVEL=info

# --- database ----------------------------------------------------------------
# Local dev:     mongodb://127.0.0.1:27017/adiyogi
# docker compose (API container): mongodb://mongo:27017/adiyogi
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adiyogi?retryWrites=true&w=majority
# Use the hostname/connection string appropriate to where the API runs.
MONGODB_URI=mongodb://127.0.0.1:27017/adiyogi
# Database name; must match the path component of MONGODB_URI.
MONGODB_DB_NAME=adiyogi

# --- client / CORS -----------------------------------------------------------
# Exact browser origin(s) of the SPA. Must be an origin only (scheme + host +
# port, no trailing slash, no path). CLIENT_URL is the primary origin; extra
# origins (preview deployments, custom domain during migration) go in
# CLIENT_URLS as a comma-separated list.
#   local Vite dev:  http://localhost:5173
#   local compose:   http://localhost:8080
#   Vercel:          https://adiyogi.vercel.app  (or https://app.example.com)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=

# --- auth / crypto -----------------------------------------------------------
# REQUIRED. 32+ random hex chars each (openssl rand -hex 32). Never reuse between
# environments. JWT_SECRET signs the 15-minute access JWT; SESSION_SECRET signs
# CSRF tokens and keys the HMAC used to hash client IPs.
JWT_SECRET=
SESSION_SECRET=
# Access-token lifetime in minutes; refresh-session lifetime in days.
ACCESS_TOKEN_TTL_MIN=15
SESSION_TTL_DAYS=30
# Set only when the API shares a parent domain with the web app, e.g.
# COOKIE_DOMAIN=.example.com for app.example.com + api.example.com. Leave empty
# for host-only cookies (correct for localhost and for *.vercel.app + *.onrender.com).
COOKIE_DOMAIN=
# Force the `Secure` cookie flag. Automatically true when NODE_ENV=production;
# keep false for plain-HTTP local development.
COOKIE_SECURE=false
# `lax` is correct when the SPA and API share a registrable domain (recommended:
# app.example.com + api.example.com). Use `none` ONLY when they do not (e.g.
# *.vercel.app SPA + *.onrender.com API) — it requires HTTPS and COOKIE_SECURE=true,
# and some browsers (Safari/ITP) restrict cross-site cookies, so the shared-domain
# setup is strongly preferred. See docs/DEPLOYMENT.md.
COOKIE_SAMESITE=lax

# --- AI provider (SERVER-ONLY: this key must never reach the browser build) ---
# Get a key at https://aistudio.google.com/apikey
# If AI_API_KEY is empty the chat endpoint returns an honest 503 AI_UNAVAILABLE —
# it never fabricates an AI reply. There is no client-side AI call from the SPA.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
# Per-request provider timeout; one retry is attempted on 5xx/timeout.
AI_TIMEOUT_MS=20000
# When true, a provider failure also returns an explicitly-labelled NON-AI guided
# exercise in error.details (never presented as an AI message).
AI_FALLBACK_GUIDED=true

# --- privacy / retention (MongoDB TTL indexes) -------------------------------
CHAT_RETENTION_DAYS=30
CRISIS_EVENT_RETENTION_DAYS=90

# --- rate limits (defaults are sane; override only when needed) --------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
CHAT_RATE_LIMIT_MAX=20

# --- bootstrap ---------------------------------------------------------------
# Seed the board taxonomy on startup (idempotent).
SEED_ON_START=true
# Optional one-time admin bootstrap; only created when it does not already exist.
# Set both, deploy once, then remove them from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
